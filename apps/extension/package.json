{
  "name": "extension",
  "description": "Youtube Watch Thumbnails",
  "private": true,
  "license": "MIT",
  "version": "4.1.1",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "devc": "wxt -b chrome",
    "devf": "wxt -b firefox",
    "build": "wxt build -b chrome && wxt build -b firefox",
    "buildc": "wxt build -b chrome",
    "buildf": "wxt build -b firefox",
    "zip": "wxt zip -b chrome && wxt zip -b firefox",
    "zipc": "wxt zip -b chrome",
    "zipf": "wxt zip -b firefox",
    "bz": "pnpm run zip",
    "compile": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "postinstall": "wxt prepare",
    "build:e2e": "wxt build -b chrome",
    "test:e2e": "pnpm run build:e2e && playwright test"
  },
  "dependencies": {
    "@webext-core/messaging": "^4.0.1",
    "@wxt-dev/i18n": "^0.2.8",
    "clsx": "^2.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "~1.64.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/auto-icons": "^1.1.2",
    "@wxt-dev/module-react": "^1.2.2",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wxt": "^0.21.5"
  }
}
