{
    // パスエイリアス（@/*, #i18n など）は WXT が生成する .wxt/tsconfig.json に定義されている
    "extends": "./.wxt/tsconfig.json",
    "compilerOptions": {
        "allowImportingTsExtensions": true,
        "jsx": "react-jsx"
    },
    "include": ["src", "e2e", "*.config.ts", ".wxt/wxt.d.ts"],
    "exclude": ["node_modules", ".output"]
}
