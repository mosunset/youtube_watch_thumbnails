---
import LanguageSelect from "@astrojs/starlight/components/LanguageSelect.astro";
import SocialIcons from "@astrojs/starlight/components/SocialIcons.astro";
import ThemeSelect from "@astrojs/starlight/components/ThemeSelect.astro";
---

<div class="mobile-preferences sl-flex">
    <div class="social-icons">
        <a
            href="https://chromewebstore.google.com/detail/youtube-watch-thumbnails/aobeafpjgdgakpagffmlkfeognaiigci"
            target="_blank"
            rel="noopener noreferrer"
        >
            <img
                src="https://img.shields.io/badge/Chrome-4285F4?logo=googlechrome&logoColor=white"
                alt="Chrome Web Store"
            />
        </a>
        <a
            href="https://addons.mozilla.org/ja/firefox/addon/youtube-watch-thumbnails/"
            target="_blank"
            rel="noopener noreferrer"
        >
            <img
                src="https://img.shields.io/badge/Firefox-FF7139?logo=firefoxbrowser&logoColor=white"
                alt="Firefox Add-ons"
            />
        </a>

        <SocialIcons {...Astro.props} />
    </div>
    <ThemeSelect {...Astro.props} />
    <LanguageSelect {...Astro.props} />
</div>

<style>
    .social-icons {
        display: flex;
        margin-inline-end: auto;
        gap: 1rem;
        align-items: center;
        padding-block: 1rem;
    }
    .social-icons:empty {
        display: none;
    }

    .social-icons a {
        display: flex;
        align-items: center;
        text-decoration: none;
        color: inherit;
    }

    .social-icons img {
        height: 20px;
        width: auto;
        display: block;
    }

    .mobile-preferences {
        justify-content: space-between;
        flex-wrap: wrap;
        border-top: 1px solid var(--sl-color-gray-6);
        column-gap: 1rem;
        padding: 0.5rem 0;
    }
</style>
